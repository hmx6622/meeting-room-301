/* pages/admin/admin.wxss */

.auth-sub {
  font-size: 24rpx;
  color: #B0B5BC;
  margin-top: 16rpx;
  padding: 0 60rpx;
  line-height: 1.6;
}

/* tab 切换 */
.tab-bar {
  display: flex;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  color: #646A73;
  border-radius: 12rpx;
  position: relative;
}
.tab-item.active {
  background: #2B5D46;
  color: #FFFFFF;
  font-weight: 600;
}
.tab-badge {
  display: inline-block;
  min-width: 32rpx;
  padding: 0 8rpx;
  margin-left: 6rpx;
  background: #D54941;
  color: #FFFFFF;
  font-size: 20rpx;
  border-radius: 20rpx;
  line-height: 1.5;
}
.tab-item.active .tab-badge {
  background: #FFFFFF;
  color: #D54941;
}

.record-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}
.applicant {
  font-size: 30rpx;
  font-weight: 600;
}
.record-line {
  display: flex;
  font-size: 27rpx;
  line-height: 1.9;
}
.line-label {
  width: 140rpx;
  color: #8A8F99;
  flex-shrink: 0;
}
.line-value {
  flex: 1;
}
.phone {
  color: #2B5D46;
}

.audit-actions {
  display: flex;
  margin-top: 24rpx;
  gap: 24rpx;
}
.audit-btn {
  flex: 1;
  margin-top: 0;
}
.audit-btn.reject {
  color: #D54941;
  border-color: #D54941;
}
