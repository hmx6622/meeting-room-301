<!--pages/my/my.wxml 我的申请列表-->
<view class="container">

  <view wx:if="{{list.length === 0 && !loading}}" class="empty">
    <text class="empty-icon">📋</text>
    <view>暂无借用申请记录</view>
  </view>

  <view wx:for="{{list}}" wx:key="_id" class="card record-card">

    <!-- 顶部：日期 + 状态 -->
    <view class="record-head">
      <text class="record-date">{{item.dateStr}}</text>
      <text class="tag {{item.statusClass}}">{{item.statusText}}</text>
    </view>

    <!-- 详情 -->
    <view class="record-line">
      <text class="line-label">借用时段</text>
      <text class="line-value">{{item.timeText}}</text>
    </view>
    <view class="record-line">
      <text class="line-label">部门社团</text>
      <text class="line-value">{{item.applicantDept}}</text>
    </view>
    <view class="record-line">
      <text class="line-label">使用人数</text>
      <text class="line-value">{{item.peopleNum}}人</text>
    </view>
    <view class="record-line">
      <text class="line-label">借用事由</text>
      <text class="line-value">{{item.useReason}}</text>
    </view>

    <!-- 驳回原因 -->
    <view class="remark reject-remark" wx:if="{{item.status === 2 && item.auditRemark}}">
      驳回原因：{{item.auditRemark}}
    </view>
    <!-- 审批备注 -->
    <view class="remark pass-remark" wx:if="{{item.status === 1 && item.auditRemark}}">
      审批备注：{{item.auditRemark}}
    </view>

    <!-- 取消按钮：仅待审批可取消 -->
    <button
      wx:if="{{item.status === 0}}"
      class="btn-danger cancel-btn"
      data-id="{{item._id}}"
      bindtap="onCancel"
    >取消申请</button>
  </view>

</view>
