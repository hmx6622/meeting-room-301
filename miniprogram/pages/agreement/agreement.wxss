/* pages/agreement/agreement.wxss */
.agreement-page {
  min-height: 100vh;
  background: #F6F7FB;
}

.tabs {
  display: flex;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 10;
  border-bottom: 1rpx solid #eee;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #2B5D46;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  transform: translateX(-50%);
  width: 56rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #2B5D46;
}

.content {
  padding: 32rpx 28rpx 60rpx;
}

.doc-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1a1a1a;
  text-align: center;
  margin-bottom: 16rpx;
}

.updated {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  line-height: 1.6;
}

.h2 {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  margin: 36rpx 0 16rpx;
}

.p {
  font-size: 27rpx;
  color: #444;
  line-height: 1.85;
  margin-bottom: 12rpx;
  text-align: justify;
}
