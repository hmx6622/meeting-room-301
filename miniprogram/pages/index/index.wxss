/* pages/index/index.wxss */

.room-card {
  background: linear-gradient(135deg, #2B5D46 0%, #3C7A5C 100%);
  color: #FFFFFF;
}
.room-title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.room-line {
  font-size: 28rpx;
  opacity: 0.92;
  line-height: 1.9;
}
.room-status {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  font-size: 26rpx;
}
.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}
.dot-on {
  background: #7BE0A4;
  box-shadow: 0 0 8rpx #7BE0A4;
}
.dot-off {
  background: #FFB3AD;
}

/* 日期卡片 */
.date-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.date-main {
  font-size: 34rpx;
  font-weight: 600;
  color: #1F2329;
}
.date-arrow {
  font-size: 44rpx;
  color: #8A8F99;
}
.quick-bar {
  display: flex;
  margin-top: 24rpx;
  gap: 20rpx;
}
.quick-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  background: #F2F4F6;
  color: #646A73;
  font-size: 26rpx;
}
.quick-btn.active {
  background: #E6F4EC;
  color: #2B8A5B;
  font-weight: 600;
}

/* 时段网格 */
.grid-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}
.time-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}
.time-item {
  border-radius: 14rpx;
  padding: 20rpx 0;
  text-align: center;
  display: flex;
  flex-direction: column;
}
.slot-time {
  font-size: 28rpx;
  font-weight: 600;
}
.slot-state {
  font-size: 22rpx;
  margin-top: 6rpx;
}
.time-item.free {
  background: #E6F4EC;
  color: #2B8A5B;
}
.time-item.occupied {
  background: #FDECEB;
  color: #D54941;
}

.legend {
  display: flex;
  justify-content: center;
  margin-top: 28rpx;
  gap: 48rpx;
}
.legend-item {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #646A73;
}
.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 6rpx;
  margin-right: 10rpx;
}
.legend-dot.free { background: #7BE0A4; }
.legend-dot.occupied { background: #F08A83; }
