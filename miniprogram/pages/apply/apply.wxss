/* pages/apply/apply.wxss */

.date-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.date-label {
  color: #646A73;
  font-size: 28rpx;
}
.date-value {
  font-size: 34rpx;
  font-weight: 600;
  color: #2B5D46;
}

.occupied-tip {
  background: #FFF9F0;
}
.tip-title {
  font-size: 26rpx;
  color: #E8860B;
  margin-bottom: 16rpx;
  font-weight: 600;
}
.tip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.tip-time {
  background: #FDECEB;
  color: #D54941;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
}

input {
  width: 100%;
  height: 48rpx;
}
.picker-value {
  color: #1F2329;
}
.picker-placeholder {
  color: #B0B5BC;
}
.reason-input {
  width: 100%;
  height: 160rpx;
  font-size: 28rpx;
  line-height: 1.6;
}
.word-count {
  text-align: right;
  font-size: 22rpx;
  color: #B0B5BC;
  margin-top: 8rpx;
}

/* 协议勾选 */
.agreement-check {
  display: flex;
  align-items: flex-start;
  padding: 8rpx 12rpx 24rpx;
}
.checkbox {
  width: 36rpx;
  height: 36rpx;
  min-width: 36rpx;
  border: 2rpx solid #B0B5BC;
  border-radius: 50%;
  margin-right: 14rpx;
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.checkbox.checked {
  background: #2B5D46;
  border-color: #2B5D46;
}
.check-icon {
  color: #fff;
  font-size: 24rpx;
  line-height: 1;
}
.agreement-text {
  font-size: 26rpx;
  color: #646A73;
  line-height: 1.6;
  flex: 1;
}
.link {
  color: #2B5D46;
}
